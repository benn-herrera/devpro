# where the wheel and the sdist land
dist/
# the setuptools build's metadata directory
*.egg-info/

# this repo's own render tree (justfile RENDERED_DIR): a build product, produced
# on demand by the same install path a consuming project gets. Never committed.
rendered/

# the declarations `just lint` type-checks the shipped opencode TypeScript resources
# against: dev-time only, installed before the check runs, and never committed. The
# lockfile beside package.json pins the graph.
node_modules/

